<Window x:Class="LockedAgent.JoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,4,0,24">
            <TextBlock Text="Locked" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Espace étudiant" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16"
                Padding="20" BorderBrush="#EAEAEC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Adresse du serveur" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ServerUrlBox" Text="http://localhost:4000"
                         Style="{StaticResource RoundedTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,14"/>

                <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,14"/>

                <StackPanel x:Name="RegisterFields" Visibility="Collapsed">
                    <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LastNameBox" Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,14" CharacterCasing="Upper"/>

                    <TextBlock Text="Prénom" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FirstNameBox" Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,14" TextChanged="FirstNameBox_TextChanged"/>

                    <TextBlock Text="Code classe" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ClassCodeBox" Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,14" CharacterCasing="Upper"/>
                </StackPanel>

                <Button x:Name="ContinueButton" Content="Continuer"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                        Click="ContinueButton_Click" Margin="0,4,0,10"/>

                <Button x:Name="ToggleModeButton" Content="Nouveau sur Locked ? Créer un compte"
                        Style="{StaticResource LinkButton}" HorizontalAlignment="Center"
                        Click="ToggleModeButton_Click"/>

                <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}"
                           Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
