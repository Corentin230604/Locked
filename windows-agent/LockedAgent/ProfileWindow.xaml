<Window x:Class="LockedAgent.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locked — Profil" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                Padding="20" BorderBrush="#EAEAEC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Profil" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="EmailText" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Établissement" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="SchoolText" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Classe" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="ClassText" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <TextBlock Text="Abonnement" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="StatusText" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Pour changer de classe, contacte l'administrateur de ton établissement."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,16"/>

                <Button Content="Fermer" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
