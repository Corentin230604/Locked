<Window x:Class="LockedAgent.TestExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI">
    <Border Background="#E61D1D1F" CornerRadius="12" Padding="14,10">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="MODE TEST" Foreground="White" FontWeight="Bold" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="ExitButton" Content="Quitter le test"
                    Style="{StaticResource PrimaryButton}"
                    Padding="10,4" FontSize="12"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Border>
</Window>
